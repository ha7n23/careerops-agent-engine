# Application
CAREEROPS_APP_NAME="CareerOps Agent Engine"
CAREEROPS_APP_VERSION="0.1.0"
CAREEROPS_ENVIRONMENT="development"
CAREEROPS_DEBUG=false

# API authentication
# development: X-User-ID only
# service_key: X-User-ID + X-CareerOps-Service-Key
CAREEROPS_AUTH_MODE="development"

# Required when CAREEROPS_AUTH_MODE="service_key".
# Use a strong random value of at least 32 characters.
CAREEROPS_SERVICE_API_KEY=

# LLM
CAREEROPS_LLM_MODEL="gemini-3.5-flash-lite"
CAREEROPS_LLM_TEMPERATURE=1.0
CAREEROPS_LLM_TIMEOUT_SECONDS=60
CAREEROPS_LLM_MAX_RETRIES=2
CAREEROPS_LLM_REQUESTS_PER_MINUTE=4
GOOGLE_API_KEY=

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="careerops-agent-engine"
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_TRACING_SAMPLING_RATE=1.0

# Evidence-discovery agent limits
CAREEROPS_EVIDENCE_AGENT_MAX_MODEL_CALLS=6
CAREEROPS_EVIDENCE_AGENT_MAX_TOOL_CALLS=4
CAREEROPS_EVIDENCE_AGENT_MAX_SEARCH_CALLS=3
CAREEROPS_EVIDENCE_AGENT_RECURSION_LIMIT=50

# PostgreSQL
CAREEROPS_DATABASE_URL="postgresql+psycopg://careerops:careerops_local_dev@127.0.0.1:5432/careerops"
CAREEROPS_LANGGRAPH_DATABASE_URI="postgresql://careerops:careerops_local_dev@127.0.0.1:5432/careerops"
CAREEROPS_DATABASE_POOL_SIZE=5
CAREEROPS_DATABASE_MAX_OVERFLOW=10

# LangGraph checkpoint security
LANGGRAPH_STRICT_MSGPACK=true

# LibreOffice Executable Path
CAREEROPS_LIBREOFFICE_EXECUTABLE="C:/Program Files/LibreOffice/program/soffice.exe"
